# Copy to .env (never commit .env). No secrets are needed: the POC runs 100% local without auth.

# docker compose (PostgreSQL)
POSTGRES_USER=provenly
POSTGRES_PASSWORD=provenly
POSTGRES_DB=provenly
POSTGRES_PORT=5432

# backend
PROVENLY_DATABASE_URL=postgres://provenly:provenly@localhost:5432/provenly?sslmode=disable
PROVENLY_HTTP_ADDR=:8080
PROVENLY_LOG_LEVEL=info
PROVENLY_ENV=development
# Apply pending goose migrations when `serve` starts (scripts use `migrate up` explicitly).
PROVENLY_AUTO_MIGRATE=false
# Maximum JUnit report size accepted by the ingestion endpoint (bytes).
PROVENLY_MAX_INGEST_BYTES=10485760

# frontend (vite dev/preview proxy target for /api)
PROVENLY_API_URL=http://localhost:8080

# e2e (Playwright) — uses a separate database
E2E_DATABASE_URL=postgres://provenly:provenly@localhost:5432/provenly_e2e?sslmode=disable
