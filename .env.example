# Docker environments are configured in envs/<env>.env (demo, qa; prod from
# envs/prod.env.example). This file is only for running the services WITHOUT
# docker: `cp .env.example .env.local`, then `make dev-backend` / `dev-frontend` /
# `migrate` load it (its values win over the defaults and your shell). Not `.env`:
# docker compose reads `.env` automatically and it would change the docker
# environments. No secrets are needed.

# backend: points at the qa database by default (start it with `make infra ENV=qa`)
PROVENLY_DATABASE_URL=postgres://provenly:provenly@localhost:5433/provenly?sslmode=disable
PROVENLY_HTTP_ADDR=:8080
PROVENLY_LOG_LEVEL=info
PROVENLY_ENV=development
# Apply pending goose migrations when `serve` starts (`make dev-backend` always does).
PROVENLY_AUTO_MIGRATE=false
# Maximum JUnit report size accepted by the ingestion endpoint (bytes).
PROVENLY_MAX_INGEST_BYTES=10485760

# frontend (vite dev/preview proxy target for /api)
PROVENLY_API_URL=http://localhost:8080

# e2e / screenshots: leave unset to get an ephemeral in-memory database per run
# (docker-compose.e2e.yml); set it to reuse an existing one (CI service container).
# E2E_DATABASE_URL=postgres://provenly:provenly@localhost:5439/provenly_e2e?sslmode=disable
