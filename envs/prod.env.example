# prod: real data for a project. Copy to envs/prod.env (git-ignored) and set a
# strong password. Starts empty (no SEED). Resets require CONFIRM=prod and take
# a dump first. Keep BIND_ADDR on 127.0.0.1 until TLS is in front of it.
PROVENLY_ENV=prod
WEB_PORT=3200
API_PORT=8280
DB_PORT=5434
SEED=
PROVENLY_LOG_LEVEL=info
POSTGRES_USER=provenly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=provenly
BIND_ADDR=127.0.0.1
# Required: signs sessions; at least 32 characters, e.g. `openssl rand -hex 32`.
PROVENLY_JWT_SECRET=
# Encrypts webhook secrets and connector tokens at rest: openssl rand -base64 32 (keep it; losing it loses them).
PROVENLY_SECRETS_KEY=
# First administrator, created only while the database has no users.
PROVENLY_ADMIN_USERNAME=
PROVENLY_ADMIN_PASSWORD=
# Released images instead of local builds (docs/self-hosting.md): IMAGE_PREFIX=ghcr.io/edcrove/ IMAGE_TAG=v0.2.0
# with `docker compose --env-file envs/prod.env up -d --no-build --wait`.
IMAGE_PREFIX=
IMAGE_TAG=
