# Rendered by the nginx image (envsubst) at start: only ${API_UPSTREAM} is replaced.

# The scheme the browser used: a TLS proxy in front of this container (docs/self-hosting.md) says so in
# X-Forwarded-Proto; without one it is this server's own scheme. The API marks the session cookie Secure on https.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 80;
    root /usr/share/nginx/html;

    # Docker DNS; re-resolved so a restarted api container is picked up.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    # JUnit reports up to PROVENLY_MAX_INGEST_BYTES (10 MiB by default).
    client_max_body_size 11m;
    # A body over nginx's own limit gets the API's problem+json, not an HTML page.
    error_page 413 = @payload_too_large;
    location @payload_too_large {
        default_type application/problem+json;
        return 413 '{"type":"about:blank","title":"Request Entity Too Large","status":413,"code":"payload_too_large","detail":"request body is too large"}';
    }

    location /api/ {
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        include /etc/nginx/security-headers.conf;
    }

    location ~ ^/(healthz|readyz)$ {
        proxy_pass $api_upstream;
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/security-headers.conf;
        try_files $uri =404;
    }

    # Single-page app: every other route is rendered by the client router.
    location / {
        add_header Cache-Control "no-cache";
        include /etc/nginx/security-headers.conf;
        try_files $uri /index.html;
    }
}
