# qa: manual testing. Starts from the `demo` snapshot (change SEED to any
# seeds/<name>.sql, e.g. one taken with `make seed-snapshot`); reset freely.
PROVENLY_ENV=qa
WEB_PORT=3100
API_PORT=8180
DB_PORT=5433
SEED=demo
PROVENLY_LOG_LEVEL=debug
POSTGRES_USER=provenly
POSTGRES_PASSWORD=provenly
POSTGRES_DB=provenly
# Local-only administrator, created when the database has no users, and a fixed
# session secret so sign-ins survive restarts. Demo values, not secrets: never
# reuse them outside a local machine (prod sets its own, see prod.env.example).
PROVENLY_ADMIN_USERNAME=admin
PROVENLY_ADMIN_PASSWORD=provenly-demo
PROVENLY_JWT_SECRET=local-demo-only-session-secret-not-a-secret
